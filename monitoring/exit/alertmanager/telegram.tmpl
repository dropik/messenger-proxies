{{ .Annotations.summary | html }}
{{ end -}}
{{ range .Alerts.Resolved -}}
✅ <b>{{ .Labels.alertname }}</b> resolved · {{ .StartsAt.UTC.Format "15:04" }}–{{ .EndsAt.UTC.Format "15:04" }} UTC
{{ .Annotations.summary | html }}
