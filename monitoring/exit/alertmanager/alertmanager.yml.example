# Copy to alertmanager.yml (gitignored) and set chat_id. Until the bot exists, use the
# "null" version at the bottom.
#
# Secrets, in alertmanager/secrets/ (gitignored; the container runs as uid/gid 65534):
#   telegram_token   bot token from @BotFather            (root:65534, 0640)
#   healthchecks_url ping URL of a healthchecks.io check  (optional, same permissions)
#
# Critical alerts notify with sound; warnings arrive silently.
templates:
  - /etc/alertmanager/*.tmpl

route:
  receiver: telegram
  group_by: [alertname, host]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 6h
  routes:
    # The always-firing Watchdog proves the alert chain works. Without a healthchecks.io
    # check it goes nowhere; with one, use the heartbeat receiver below:
    #   receiver: heartbeat
    #   group_wait: 0s
    #   group_interval: 1m
    #   repeat_interval: 2m
    - matchers: [ 'alertname="Watchdog"' ]
      receiver: "null"
    - matchers: [ 'severity="warning"' ]
      receiver: telegram-quiet

# One message for one cause: the alerts that follow from a bigger one stay quiet.
inhibit_rules:
  - source_matchers: [ 'alertname="RelayDataMissing"' ]
    target_matchers: [ 'host="relay"', 'alertname!="RelayDataMissing"' ]
  - source_matchers: [ 'alertname="AllExitPathsDown"' ]
    target_matchers: [ 'alertname=~"CloudflarePathDown|FallbackPathDown|SplitPathDown|ProbeForwardFailing|ProbeTargetFailing|ProbeSlow"' ]
  - source_matchers: [ 'alertname=~"ProbeForwardFailing|ProbeDirectFailing"' ]
    target_matchers: [ 'alertname="ProbeTargetFailing"' ]
    equal: [ group ]

receivers:
  - name: "null"
  - name: telegram
    telegram_configs:
      - bot_token_file: /etc/alertmanager/secrets/telegram_token
        chat_id: 0            # your numeric chat id with the bot
        parse_mode: HTML
        message: '{{ template "telegram.vpn" . }}'
        send_resolved: true
  - name: telegram-quiet
    telegram_configs:
      - bot_token_file: /etc/alertmanager/secrets/telegram_token
        chat_id: 0
        parse_mode: HTML
        message: '{{ template "telegram.vpn" . }}'
        send_resolved: true
        disable_notifications: true
  # - name: heartbeat
  #   webhook_configs:
  #     - url_file: /etc/alertmanager/secrets/healthchecks_url
  #       send_resolved: false

# --- "null" version, before the bot exists ---
# route:
#   receiver: "null"
# receivers:
#   - name: "null"
