# /etc/monitoring/collect.env on the exit. Paths are the exit's checkout.
COLLECT_ARGS=--xray exit=http://10.213.0.20:11111/debug/vars --container vless-exit --container mon-victoriametrics --container mon-vmalert --container mon-alertmanager --container mon-grafana --container mon-node-exporter --cert cloudflare_origin=/home/debian/messenger-proxies/vless-exit/certs/cert.pem --cert letsencrypt=/home/debian/messenger-proxies/vless-exit/certs/origin-fullchain.pem --log xray_dns_error=vless-exit=app/dns --log xray_error=vless-exit=Error] --log xray_warning=vless-exit=Warning] --file-age cdn_ranges=/etc/cdn-only-firewall/ips-v4
