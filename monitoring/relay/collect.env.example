# /etc/monitoring/collect.env on the relay
COLLECT_ARGS=--xray relay=http://127.0.0.1:11111/debug/vars --container vless-relay --container vless-decoy --container mon-vmagent --container mon-node-exporter --container mon-probe --log xray_health_fail=vless-relay=error.ping --log xray_error=vless-relay=Error] --log xray_warning=vless-relay=Warning] --sockets clients=vless-relay=443
