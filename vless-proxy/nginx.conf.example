events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    sendfile on;
    keepalive_timeout 65;

    # Redirect HTTP → HTTPS
    server {
        listen 80;
        server_name YOUR_DOMAIN;
        return 301 https://$host$request_uri;
    }

    server {
        listen 443 ssl;
        server_name YOUR_DOMAIN;

        ssl_certificate     /etc/nginx/certs/cert.pem;
        ssl_certificate_key /etc/nginx/certs/key.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;
        ssl_session_cache   shared:SSL:10m;
        ssl_session_timeout 10m;

        # VLESS/xhttp — proxy to Xray internally
        location /your-secret-path {
            proxy_pass http://xray-proxy:2443;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }

        # Fake auth API — login always returns 401
        location = /api/auth/login {
            add_header Content-Type application/json;
            return 401 '{"error":"invalid_credentials","message":"Неверный email или пароль"}';
        }

        # Fake auth API — register returns 503
        location = /api/auth/register {
            add_header Content-Type application/json;
            return 503 '{"error":"service_unavailable","message":"Сервис временно недоступен. Попробуйте позже."}';
        }

        # Everything else — serve the website
        location / {
            root /usr/share/nginx/html;
            index index.html;
            try_files $uri $uri.html $uri/ =404;
        }

        error_page 404 /404.html;
        location = /404.html {
            root /usr/share/nginx/html;
            internal;
        }
    }
}
