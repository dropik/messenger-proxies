{
  "inbounds": [
    {
      "port": 2443,
      "listen": "0.0.0.0",
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "CLIENT_UUID",
            "flow": ""
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "none",
        "xhttpSettings": {
          "path": "/your-secret-path",
          "host": "YOUR_DOMAIN",
          "mode": "auto"
        }
      }
    }
  ],
  "outbounds": [
    {
      "tag": "vless-vpn",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "VPN_SERVER_IP",
            "port": 443,
            "users": [
              {
                "id": "VPN_UUID",
                "flow": "xtls-rprx-vision",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "fingerprint": "chrome",
          "serverName": "www.google.com",
          "publicKey": "VPN_REALITY_PUBLIC_KEY",
          "shortId": "VPN_SHORT_ID",
          "spiderX": "/"
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {}
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {}
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "domain": [
          "geosite:youtube",
          "geosite:telegram",
          "geosite:whatsapp"
        ],
        "outboundTag": "vless-vpn"
      },
      {
        "type": "field",
        "ip": [
          "geoip:telegram"
        ],
        "outboundTag": "vless-vpn"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "direct"
      }
    ]
  }
}
