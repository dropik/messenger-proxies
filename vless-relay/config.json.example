{
  "log": {
    "loglevel": "warning",
    "access": "none"
  },
  "inbounds": [
    {
      "tag": "vless-in",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          { "id": "FORWARD_UUID", "email": "forward@relay", "flow": "" },
          { "id": "DIRECT_UUID", "email": "direct@relay", "flow": "" }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "xhttpSettings": {
          "path": "/CLIENT_XHTTP_PATH",
          "host": "WHITELISTED_SNI",
          "mode": "auto"
        },
        "realitySettings": {
          "show": false,
          "dest": "decoy:8443",
          "xver": 0,
          "serverNames": ["WHITELISTED_SNI"],
          "privateKey": "REALITY_PRIVATE_KEY",
          "minClientVer": "",
          "maxClientVer": "",
          "maxTimeDiff": 60000,
          "shortIds": ["SHORT_ID"]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "UseIPv4"
        }
      }
    },
    {
      "tag": "exit-cdn",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "CDN_HOSTNAME",
            "port": 443,
            "users": [{ "id": "RELAY_UUID", "encryption": "none" }]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "CDN_HOSTNAME",
          "fingerprint": "chrome",
          "alpn": ["h2"]
        },
        "xhttpSettings": {
          "path": "/XHTTP_PATH",
          "host": "CDN_HOSTNAME",
          "mode": "stream-up",
          "xmux": { "maxConcurrency": "4-8", "hMaxRequestTimes": "200-400", "hMaxReusableSecs": "600-900" }
        }
      }
    },
    {
      "tag": "exit-cdn-2",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "CDN_IP_2",
            "port": 443,
            "users": [{ "id": "RELAY_UUID", "encryption": "none" }]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "CDN_HOSTNAME",
          "fingerprint": "chrome",
          "alpn": ["h2"]
        },
        "xhttpSettings": {
          "path": "/XHTTP_PATH",
          "host": "CDN_HOSTNAME",
          "mode": "stream-up",
          "xmux": { "maxConcurrency": "4-8", "hMaxRequestTimes": "200-400", "hMaxReusableSecs": "600-900" }
        }
      }
    },
    {
      "tag": "exit-cfws",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "CLOUDFRONT_HOSTNAME",
            "port": 443,
            "users": [{ "id": "RELAY_UUID", "encryption": "none" }]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "serverName": "CLOUDFRONT_HOSTNAME",
          "fingerprint": "chrome",
          "alpn": ["http/1.1"]
        },
        "wsSettings": {
          "path": "/WS_PATH",
          "host": "CLOUDFRONT_HOSTNAME"
        }
      }
    },
    {
      "tag": "yt-cf-1",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "CDN_HOSTNAME",
            "port": 443,
            "users": [{ "id": "RELAY_UUID", "encryption": "none" }]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "CDN_HOSTNAME",
          "fingerprint": "chrome",
          "alpn": ["h2"]
        },
        "xhttpSettings": {
          "path": "/XHTTP_PATH",
          "host": "CDN_HOSTNAME",
          "mode": "stream-up",
          "xmux": { "maxConcurrency": "4-8", "hMaxRequestTimes": "200-400", "hMaxReusableSecs": "600-900" }
        }
      }
    },
    {
      "tag": "yt-cf-2",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "CDN_IP_2",
            "port": 443,
            "users": [{ "id": "RELAY_UUID", "encryption": "none" }]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "CDN_HOSTNAME",
          "fingerprint": "chrome",
          "alpn": ["h2"]
        },
        "xhttpSettings": {
          "path": "/XHTTP_PATH",
          "host": "CDN_HOSTNAME",
          "mode": "stream-up",
          "xmux": { "maxConcurrency": "4-8", "hMaxRequestTimes": "200-400", "hMaxReusableSecs": "600-900" }
        }
      }
    },
    {
      "tag": "yt-split-1",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "CDN_HOSTNAME",
            "port": 443,
            "users": [{ "id": "RELAY_UUID", "encryption": "none" }]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "CDN_HOSTNAME",
          "fingerprint": "chrome",
          "alpn": ["h2"]
        },
        "xhttpSettings": {
          "path": "/XHTTP_PATH",
          "host": "CDN_HOSTNAME",
          "mode": "stream-up",
          "xmux": { "maxConcurrency": "4-8", "hMaxRequestTimes": "200-400", "hMaxReusableSecs": "600-900" },
          "downloadSettings": {
            "address": "CLOUDFRONT_HOSTNAME",
            "port": 443,
            "network": "xhttp",
            "security": "tls",
            "tlsSettings": {
              "serverName": "CLOUDFRONT_HOSTNAME",
              "fingerprint": "chrome",
              "alpn": ["h2"]
            },
            "xhttpSettings": { "path": "/XHTTP_PATH" }
          }
        }
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ],
  "burstObservatory": {
    "subjectSelector": ["exit-", "yt-"],
    "pingConfig": {
      "destination": "https://www.gstatic.com/generate_204",
      "interval": "1m",
      "sampling": 3,
      "timeout": "10s"
    }
  },
  "routing": {
    "balancers": [
      {
        "tag": "youtube",
        "selector": ["yt-"],
        "fallbackTag": "exit-cfws",
        "strategy": { "type": "leastLoad", "settings": { "expected": 3, "maxRTT": "1000ms" } }
      },
      {
        "tag": "rest",
        "selector": ["exit-cdn"],
        "fallbackTag": "exit-cfws",
        "strategy": { "type": "leastLoad", "settings": { "expected": 2, "maxRTT": "1000ms" } }
      }
    ],
    "rules": [
      {
        "type": "field",
        "user": ["direct@relay"],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": ["geosite:youtube"],
        "balancerTag": "youtube"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "balancerTag": "rest"
      }
    ]
  }
}
