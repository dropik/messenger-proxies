# Private DNS Configuration
# Copy this file to 'env' and fill in your values
# This file should NOT be committed to git

# Your DuckDNS subdomain (without .duckdns.org)
# Example: if your domain is myproxy.duckdns.org, put: myproxy
DUCKDNS_SUBDOMAIN=your_subdomain

# Your DuckDNS token (from duckdns.org dashboard)
DUCKDNS_TOKEN=your_token_here

# Your VPS IP (for WhatsApp DNS rewrites)
PROXY_IP=your_vps_ip

# Email for Let's Encrypt certificate expiry notifications (optional, can be empty)
ACME_EMAIL=
